{
  "scripts": {
    "log": "node run-log.mjs",
    "log:typescript": "ts-node run-log-typescript.ts",
    "start": "ts-node-esm index.mts",
    "start:typescript": "ts-node index-typescript.ts",
    "test": "node --require ts-node/register/transpile-only --test tests/*.test.ts",
    "test:smoke": "ts-node-esm index.mts smoke",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.rust.json"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
