{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["*.ts", "*.mts", "tests/**/*.ts"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "allowImportingTsExtensions": false
    }
  }
}
