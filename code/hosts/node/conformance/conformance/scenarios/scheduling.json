        "integralGain": 0,
        "derivativeGain": 0
      }
    },
    "steps": [
      {
        "operation": "submit",
        "atMs": 0,
        "priority": 0,
        "as": "active",
        "actions": [{ "type": "start", "request": "active" }]
      },
      {
        "operation": "submit",
        "atMs": 1,
        "priority": 100,
        "as": "first",
        "actions": []
      },
      {
        "operation": "submit",
        "atMs": 2,
        "priority": 100,
        "as": "second",
        "actions": []
      },
      {
        "operation": "complete",
        "atMs": 3,
        "request": "active",
        "outcome": "success",
        "actions": [{ "type": "start", "request": "first" }]
