{
  "name": "@jfrz38/pid-controller-fastify",
  "author": "José F. Ruiz <jrz899@inlumine.ual.es>",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Fastify adapter for the Rust/WebAssembly adaptive admission controller",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@jfrz38/adaptive-admission-node": "^0.1.0",
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "5.1.0"
  },
  "scripts": {
    "build": "tsup",
    "build:clean": "npm run clean && npm run build",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:leak": "vitest --detectOpenHandles",
    "lint": "eslint src",
    "lint:src": "eslint src",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --fix"
  },
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "@jfrz38/adaptive-admission-node": "workspace:*",
    "@jfrz38/pid-controller-shared": "workspace:*",
    "fastify": "5.12.8",
    "tsup": "9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrz38/rate-limit-pid-controller.git",
    "directory": "code/adapters/fastify"
  },
  "homepage": "https://github.com/jfrz38/rate-limit-pid-controller/tree/main/code/adapters/fastify#readme"
}
