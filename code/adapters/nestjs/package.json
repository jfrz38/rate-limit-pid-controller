{
  "name": "@jfrz38/pid-controller-nestjs",
  "author": "José F. Ruiz <jrz899@inlumine.ual.es>",
  "license": "MIT",
  "version": "0.2.0",
  "description": "NestJS adapter for the Rust/WebAssembly adaptive admission controller",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@jfrz38/adaptive-admission-node": "^0.1.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrz38/rate-limit-pid-controller.git",
    "directory": "code/adapters/nestjs"
  },
  "homepage": "https://github.com/jfrz38/rate-limit-pid-controller/tree/main/code/adapters/nestjs#readme",
  "scripts": {
    "build": "tsup",
    "build:clean": "npm run clean && npm run build",
    "start": "ts-node src/index.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:leak": "vitest --detectOpenHandles",
    "lint": "eslint src",
    "lint:src": "eslint src",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --fix"
  },
  "type": "module",
  "keywords": [
    "nestjs",
    "express",
    "fastify",
    "pid-controller",
    "rate-limit",
    "resilience",
    "middleware",
    "backpressure"
  ],
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "@jfrz38/adaptive-admission-node": "workspace:*",
    "@jfrz38/pid-controller-shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "9.0.0"
  }
}
